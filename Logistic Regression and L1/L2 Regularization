        "\n",
        "# Implement the cost function here\n",
        "def regL2_cal_cost(theta, X, y, _lambda):\n",
        "  # theta[0]+ X1 * theta[1] + X2 theta[2]\n",
        "  h = np.dot(theta, X.T)\n",
        "  # h = theta[0] + np.multiply(theta[1], X.x1) + np.multiply(theta[2], X.x2)\n",
        "  htheta = np.array(sigmoid(h))\n",
        "  eps = 1e-15\n",
        "\n",
        "  penalty = _lambda * (np.square(theta[1]) + np.square(theta[2]))\n",
        "\n",
        "  term1 = np.matmul(np.log(htheta), y)\n",
        "  term2 = np.matmul(np.log( np.subtract(1, htheta) + eps), (1-y))\n",
        "  J = (-1 / y.size) * (term1 + term2) + penalty\n",
        "  return J\n",
        "\n",
        "def regL2_cal_grad(theta, X, y, _lambda):\n",
        "  h = np.dot(theta, X.T)\n",
        "  htheta = np.array(sigmoid(h))\n",
        "\n",
        "  # Calculate the unregularized gradient\n",
        "  term1 = np.matmul(np.transpose(X), (htheta - y))\n",
        "  grad = (1 / y.size) * term1\n",
        "\n",
        "\n",
        "  # Calculate the regularization term for the gradient\n",
        "  # Note: it's the theta's but squared\n",
        "  # omitting the first theta\n",
        "  grad_penalty = (_lambda / y.size) * np.array([0, np.square(theta[1]), np.square(theta[2])])\n",
        "\n",
        "  # Combine unregularized gradient with regularization term\n",
        "  grad += grad_penalty\n",
        "\n",
        "  return np.array(grad)\n",
        "\n",
        "def regL2_GD(rate, epoch, _lambda):\n",
        "\n",
        "  theta = np.zeros(3)\n",
