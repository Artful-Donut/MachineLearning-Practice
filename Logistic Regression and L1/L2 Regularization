        "# Implement the cost function here\n",
        "def cal_cost(theta, X, y):\n",
        "  # theta[0]+ X1 * theta[1] + X2 theta[2]\n",
        "  h = np.dot(theta, X.T)\n",
        "  # h = theta[0] + np.multiply(theta[1], X.x1) + np.multiply(theta[2], X.x2)\n",
        "  htheta = np.array(sigmoid(h))\n",
        "  eps = 1e-15\n",
        "\n",
        "  term1 = np.matmul(np.log(htheta), y)\n",
        "  term2 = np.matmul(np.log( np.subtract(1, htheta) + eps), (1-y))\n",
        "  J = (-1 / y.size) * (term1 + term2)\n",
        "  return J\n",
        "\n",
        "def cal_grad(theta, X, y):\n",
        "  # Xx = np.array(X[['x1', 'x2']])\n",
        "  # Xx = np.column_stack((np.ones(y.size), Xx))\n",
        "\n",
        "  # h = theta[0] + np.multiply(theta[1], X.x1) + np.multiply(theta[2], X.x2)\n",
        "  h = np.dot(theta, X.T)\n",
        "  htheta = np.array(sigmoid(h))\n",
        "\n",
        "  term1 = np.matmul(np.transpose(X), (htheta - y))\n",
        "  grad = (1 / y.size) * term1\n",
        "  return np.array(grad)\n",
